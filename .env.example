# Copy to .env for local Docker Compose and replace every value.
POSTGRES_USER=linkpay
POSTGRES_PASSWORD=
POSTGRES_DB=linkpay
# Set this to a PostgreSQL URL that is reachable from the app containers.
# For Railway, paste the connection URL here. Docker Compose passes it to the Go services as DATABASE_URL.
RAILWAY_DB_URL=
DATABASE_URL=${RAILWAY_DB_URL}
PUBLIC_TOKEN_SECRET=
PUBLIC_URL=http://localhost:8080
PORT=8080
DOMAIN=linkpay.example.com
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=
ADMIN_TOTP_SECRET=
